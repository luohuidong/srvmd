{
  "name": "srvmd",
  "version": "0.2.0",
  "description": "Static file server with live-reloading Markdown rendering, built on Node",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luohuidong/srvmd.git"
  },
  "keywords": [
    "node",
    "markdown",
    "static-server",
    "live-reload",
    "preview",
    "serve-markdown",
    "md"
  ],
  "bin": {
    "srvmd": "./dist/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:web",
    "build:node": "tsc -b tsconfig.build.json",
    "build:web": "vite build --config src/web/vite.config.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "dev:node": "cross-env SRVMD_DEV_WEB_URL=http://localhost:5180 tsx watch src/cli/src/index.ts",
    "preview": "node dist/cli/src/index.js",
    "test": "pnpm run build && pnpm run test:node && pnpm run test:web",
    "test:node": "pnpm run test:cli && pnpm run test:server && pnpm run test:root",
    "test:cli": "vitest run --config src/cli/vitest.config.ts",
    "test:server": "vitest run --config src/server/vitest.config.ts",
    "test:root": "vitest run",
    "test:web": "vitest run --config src/web/vitest.config.ts",
    "test:watch:web": "vitest --config src/web/vitest.config.ts",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "pnpm run typecheck:root && pnpm run typecheck:shared && pnpm run typecheck:server && pnpm run typecheck:cli",
    "typecheck:root": "tsc -p tsconfig.json",
    "typecheck:shared": "tsc -p src/shared/tsconfig.json",
    "typecheck:server": "tsc -p src/server/tsconfig.json",
    "typecheck:cli": "tsc -p src/cli/tsconfig.json",
    "typecheck:web": "svelte-check --workspace src/web --tsconfig tsconfig.json",
    "check": "biome check . && pnpm run check:svelte",
    "check:fix": "biome check --write . && pnpm run format:svelte",
    "check:svelte": "prettier --check \"src/web/**/*.svelte\"",
    "format:svelte": "prettier --write \"src/web/**/*.svelte\"",
    "lint": "biome lint .",
    "format": "biome format --write . && pnpm run format:svelte",
    "prepack": "pnpm run build && node src/web/scripts/verify-dist.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "mime": "^4.0.7",
    "shiki": "^4.5.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "srvmd",
  "version": "0.1.1",
  "description": "Static file server with live-reloading Markdown rendering, built on Bun",
  "type": "module",
  "bin": {
    "srvmd": "src/cli/index.ts"
  },
  "files": [
    "src",
    "web/dist",
    "!src/**/*.test.ts",
    "README.md",
    "README_CN.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/cli/index.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun src/cli/index.ts",
    "test": "bun run test:server && bun run test:web",
    "test:server": "bun test",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:watch": "vitest --config web/vitest.config.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig web/tsconfig.json",
    "check": "biome check . && prettier --check \"web/**/*.svelte\"",
    "check:fix": "biome check --write . && prettier --write \"web/**/*.svelte\"",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"web/**/*.svelte\"",
    "prepack": "bun run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "bun",
    "markdown",
    "static-server",
    "live-reload",
    "preview",
    "serve-markdown",
    "md"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "latest",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mermaid": "^12.2.0",
    "shiki": "^4.5.0"
  }
}
